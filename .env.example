# Database (Postgres). Local dev example below; production uses your host's URL.
DATABASE_URL="postgresql://postgres@localhost:5433/spectrum_hq?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="change-me-run-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Encryption key for stored OAuth tokens (32 bytes base64)
TOKEN_ENCRYPTION_KEY="change-me-run-openssl-rand-base64-32"

# Sign in providers (optional; password sign in always works)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Mail and calendar connections (same Microsoft app can be reused)
MICROSOFT_GRAPH_CLIENT_ID=""
MICROSOFT_GRAPH_CLIENT_SECRET=""
MICROSOFT_GRAPH_TENANT="common"
GOOGLE_WORKSPACE_CLIENT_ID=""
GOOGLE_WORKSPACE_CLIENT_SECRET=""

# Transactional email (invites, password resets). Any SMTP works, including Microsoft 365.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Spectrum Robotics <info@spectrumrobotics.ai>"

# Assistant
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-opus-5"

# Payments and accounting
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_ENVIRONMENT="production"

# Social
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="change-me"

# Canva Connect
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""

# Cron protection
CRON_SECRET="change-me"
